{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "desklink-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "DESKLINK_HUB", "class_name": "DeskLinkHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeskLinkHub"] }
  ],
  "observability": { "enabled": true }
}
